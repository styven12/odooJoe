# ------------------------------------------------------------------
# Configuration LOCALE (copier vers .env). Sur Render, ce fichier est
# ignoré : la production est auto-configurée dans config/settings.py.
# ------------------------------------------------------------------

DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://erp_user:change-this-password@127.0.0.1:5432/mini_odoo_db
TIME_ZONE=Africa/Douala

# Production uniquement (HTTP/HTTPS derrière un proxy) :
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Sur Render, ces variables sont OPTIONNELLES (valeurs par défaut intégrées).
# ATTENTION : ne jamais y recopier la DATABASE_URL locale (127.0.0.1) — elle
# est automatiquement ignorée sur Render, avec avertissement dans les logs.
# DATABASE_URL=postgresql://mini_odoo_user:...@dpg-.../mini_odoo   (URL Render uniquement)
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@mini-odoo.local
# ADMIN_PASSWORD=mot-de-passe-admin-de-secours
# AUTO_SETUP=1            (1 : migrations + seed + admin au démarrage ; 0 : désactiver)
# SECURE_SSL_REDIRECT=True
# GUNICORN_TIMEOUT=180
